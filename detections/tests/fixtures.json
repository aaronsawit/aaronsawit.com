 "lnx_sshd_failed_password": {
  "correlation": {
   "match": {
    "events": 12,
    "within_seconds": 120,
    "fields": {
     "src_ip": "203.0.113.5",
     "message": "Failed password for root from 203.0.113.5 port 22 ssh2"
    }
   },
   "no_match": {
    "events": 4,
    "within_seconds": 120,
    "fields": {
     "src_ip": "198.51.100.9",
     "message": "Failed password for deploy from 198.51.100.9 port 22 ssh2"
    }
   }
  }
 },
 "lnx_file_event_systemd_unit_written_outside_package_manager": {
  "match": [
   {
    "Image": "/usr/bin/curl",
    "TargetFilename": "/etc/systemd/system/dbus-helper.service"
   },
   {
    "Image": "/usr/bin/bash",
    "TargetFilename": "/home/aaron/.config/systemd/user/sync.timer"
   },
   {
    "Image": "/usr/bin/python3",
    "TargetFilename": "/usr/lib/systemd/system/updater.service"
   }
  ],
  "no_match": [
   {
    "Image": "/usr/bin/dpkg",
    "TargetFilename": "/lib/systemd/system/nginx.service"
   },
   {
    "Image": "/usr/bin/systemctl",
    "TargetFilename": "/etc/systemd/system/multi-user.target.wants/nginx.service"
   },
   {
    "Image": "/usr/bin/vim",
    "TargetFilename": "/etc/systemd/system/nginx.service.d/override.conf"
   },
   {
    "Image": "/usr/bin/curl",
    "TargetFilename": "/tmp/dbus-helper.service"
   }
  ]
 },
 "lnx_proc_docker_container_with_host_level_access": {
  "match": [
   {
    "Image": "/usr/bin/docker",
    "CommandLine": "docker run -d --privileged alpine sleep 1d"
   },
   {
    "Image": "/usr/bin/docker",
    "CommandLine": "docker run -v /var/run/docker.sock:/var/run/docker.sock tool"
   },
   {
    "Image": "/usr/bin/podman",
    "CommandLine": "podman run --pid=host -it ubuntu bash"
   },
   {
    "Image": "/usr/bin/docker",
    "CommandLine": "docker create --cap-add=SYS_ADMIN img"
   }
  ],
  "no_match": [
   {
    "Image": "/usr/bin/docker",
    "CommandLine": "docker run -d -p 8080:80 nginx"
   },
   {
    "Image": "/usr/bin/docker",
    "CommandLine": "docker ps --filter label=--privileged"
   },
   {
    "Image": "/usr/bin/vim",
    "CommandLine": "vim notes-about --privileged run .txt"
   }
  ]
 },
