{
 "win_sysmon_dll_sideload_system_dll_user_path": {
  "match": [
   {
    "EventID": 7,
    "Image": "C:\\Users\\Administrator\\Desktop\\calc.exe",
    "ImageLoaded": "C:\\Users\\Administrator\\Desktop\\WININET.dll",
    "Signed": "false",
    "Signature": "-"
   }
  ],
  "no_match": [
   {
    "EventID": 7,
    "Image": "C:\\Windows\\System32\\calc.exe",
    "ImageLoaded": "C:\\Windows\\System32\\wininet.dll",
    "Signed": "true",
    "Signature": "Microsoft Windows"
   },
   {
    "EventID": 7,
    "Image": "C:\\Users\\a\\AppData\\Local\\App\\app.exe",
    "ImageLoaded": "C:\\Users\\a\\AppData\\Local\\App\\version.dll",
    "Signed": "true",
    "Signature": "Microsoft Windows"
